{
  "name": "mailmaestro-bridge",
  "version": "1.0.0",
  "description": "High-performance IMAP/SMTP bridge for the MailMaestro SaaS app",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "iconv-lite": "0.7.3",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.1",
    "multer": "^2.2.0",
    "nodemailer": "9.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}

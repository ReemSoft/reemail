BRIDGE_API_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_32_PLUS_CHARS
PORT=3001
HOST=127.0.0.1

# --- IMAP concurrency limiter (MAILMAESTRO_IMAP_LIMITER_R3) ---
# Off by default. Set to 1/true/yes/on to enable in production.
IMAP_GATES_ENABLED=false
# Total in-flight IMAP operations across the whole bridge process.
IMAP_GLOBAL_MAX=32
# Per IMAP host (protects a single upstream from a fan-out storm).
IMAP_PER_HOST_MAX=12
# Per company (tenant fairness).
IMAP_PER_COMPANY_MAX=4
# Per account/mailbox (protects a single user's server from parallel abuse).
IMAP_PER_ACCOUNT_MAX=2
# Waiters queued when caps are full; overflow returns HTTP 503 + IMAP_BUSY.
IMAP_WAIT_QUEUE_MAX=200
# Max time a waiter blocks before returning 503 (user paths are shorter than sync).
IMAP_INTERACTIVE_WAIT_TIMEOUT_MS=8000
IMAP_BACKGROUND_WAIT_TIMEOUT_MS=30000

# --- Reusable IMAP connection + partial body fetch (fast message open) ---
# Idle time before a per-account IMAP connection is logged out (ms).
IMAP_CONN_IDLE_MS=300000
# LIST (mailbox tree) cache lifetime per account (ms).
IMAP_LIST_CACHE_MS=300000
# Max size of an inline cid: image embedded as a data URI while opening a
# message. Bigger inline images are streamed lazily through the protected
# attachment route instead (never broken).
INLINE_CID_MAX_BYTES=262144
# Set to 1 to log per-stage timings (connect / list / select / fetch) — no PII.
MAIL_BRIDGE_TIMING=0
